# Copiar a .env y completar con valores reales. Nunca commitear .env.

# Persistencia: "sqlite" en local/tests, "firestore" en GCP
STORAGE_BACKEND=sqlite
SQLITE_PATH=./vendebot.db

# LLM (Gemini via google-genai)
GEMINI_API_KEY=tu_api_key_aqui
LLM_MODEL=gemini-flash-latest
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Limites de conversacion y consumo
CHAT_HISTORY_MAX_TURNS=10
DAILY_TOKEN_BUDGET_PER_CUSTOMER=50000
PROPOSAL_EXPIRATION_MINUTES=10

# Lote reanudable
BATCH_BLOCK_SIZE=20
BATCH_MAX_ATTEMPTS=3

# Observabilidad (Langfuse)
LANGFUSE_PUBLIC_KEY=pk-lf-00000000-0000-0000-0000-000000000000
LANGFUSE_SECRET_KEY=sk-lf-00000000-0000-0000-0000-000000000000
LANGFUSE_HOST=https://cloud.langfuse.com

# GCP
GCP_PROJECT_ID=tu-proyecto-gcp
GCP_REGION=us-central1

# Puerto del servicio (Cloud Run lo inyecta automaticamente)
PORT=8080
